name = "jf-portfolio-likes"
main = "src/index.ts"
compatibility_date = "2026-11-05"
# Replace the ID and origin. This file is an example; copy it to wrangler.toml.
[vars]
ALLOWED_ORIGIN = "https://jordanferrary.github.io"
[[d1_databases]]
binding = "LIKES_DB"
database_name = "jf-portfolio-likes"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

# Enable quote reference attachments. Create this bucket before deploying.
[[r2_buckets]]
binding = "ATTACHMENTS"
bucket_name = "jf-contact-files"
